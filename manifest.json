{
  "manifest_version": 3,
  "name": "Kaczuha Duck Pet",
  "version": "1.0",
  "description": "A friendly duck that wanders your browser.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["kaczuha1.gif", "kaczuha 2 1.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
